# Data mode: "memory" (default when unset or missing credentials) or "supabase"
NEXT_PUBLIC_DATA_MODE=supabase

# Supabase Public API connection (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (NEVER expose to browser / client bundles; only used in scripts/seed.ts)
SUPABASE_SERVICE_ROLE_KEY=
